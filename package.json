{
  "name": "pilates-booking",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --parallel --if-present dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --filter '!@pilates/e2e' --if-present test",
    "test:e2e": "pnpm --filter @pilates/e2e test",
    "req:trace": "node scripts/req-trace.mjs",
    "req:check": "node scripts/req-trace.mjs --strict",
    "agent:workspace": "node scripts/agent-workspace.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm req:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
