# --- API (apps/api) ---------------------------------------------------------
NODE_ENV=development
PORT=3000
# postgres://… for real Postgres, or "pglite:memory" for an in-process database
DATABASE_URL=postgres://pilates:pilates@localhost:5432/pilates
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
STUDIO_TIMEZONE=Europe/Berlin
STUDIO_CURRENCY=eur
# Minutes a seat is held while the member pays. Stripe Checkout requires >= 30.
BOOKING_HOLD_MINUTES=30
BOOKING_CUTOFF_MINUTES=60
CANCELLATION_DEADLINE_HOURS=24

# --- Stripe (test mode keys only outside production) ------------------------
STRIPE_SECRET_KEY=sk_test_replace_me
# Printed by: stripe listen --forward-to localhost:3000/api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_replace_me
