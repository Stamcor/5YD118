{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirement module manifest",
  "type": "object",
  "required": ["id", "prefix", "title", "summary", "dependsOn", "paths"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "prefix": { "type": "string", "pattern": "^[A-Z]{2,6}$" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "dependsOn": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api": { "$ref": "#/$defs/paths" },
        "web": { "$ref": "#/$defs/paths" },
        "admin": { "$ref": "#/$defs/paths" },
        "contracts": { "$ref": "#/$defs/paths" },
        "e2e": { "$ref": "#/$defs/paths" }
      }
    }
  },
  "$defs": {
    "paths": { "type": "array", "items": { "type": "string" } }
  }
}
